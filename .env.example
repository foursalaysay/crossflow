ENABLE_LIVE_TRADING=false
ENABLE_LIVE_AUTONOMY=false
# Private UTA connection. Demo requires a separate Bitget Demo API key.
BITGET_ENV=demo
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=
# Additional per-order ceiling; full-principal risk and daily caps also apply.
BITGET_MAX_ORDER_USDT=10
LLM_API_KEY=
LLM_BASE_URL=https://hackathon.bitgetops.com/v1
LLM_MODEL=qwen3.8-max
# Optional for remote deployments only; not needed on localhost.
# APP_AUTH_TOKEN=
# Configure the paper worker assets and interval in Agent operations.
# Defaults: RNVDAUSDT + BTCUSDT, paused until explicitly enabled.

# Hackathon gateway protocol (chat_completions is also supported).
LLM_API=responses

# Separate gate for virtual-fund exchange orders.
ENABLE_DEMO_TRADING=false
ENABLE_DEMO_AUTONOMY=false
CROSSFLOW_EXECUTION_TARGET=PAPER
