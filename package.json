{
  "name": "crossflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "worker": "node --env-file=.env --import tsx scripts/worker.ts",
    "check:setup": "node --env-file=.env --import tsx scripts/check-setup.ts",
    "export:evidence": "node --import tsx scripts/export-evidence.ts",
    "demo:flow": "node --import tsx scripts/demo-flow.ts",
    "package:submission": "npm run demo:flow && node --import tsx scripts/package-submission.ts",
    "package:hackathon": "node --import tsx scripts/finalize-hackathon-submission.ts"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1",
    "lightweight-charts": "^5.0.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "type": "module"
}
